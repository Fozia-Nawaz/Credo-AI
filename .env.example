# Credo AI - Environment Template

# Local sample mode
SAMPLE_MODE=true

# NVIDIA Nemotron API (optional; not connected yet)
NVIDIA_NEMOTRON_API_KEY=your_nvidia_api_key_here

# Frontend CORS origin for local development
FRONTEND_ORIGIN=http://localhost:3000

# Zetaris Cloud Credentials
ZETARIS_CLOUD_URL=https://cloud.enterprise.zetaris.com
ZETARIS_API_KEY=your_zetaris_api_key_here

# Backend FastAPI Server Settings
PORT=8000
ENVIRONMENT=development